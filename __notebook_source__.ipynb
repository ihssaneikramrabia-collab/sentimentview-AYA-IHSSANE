
# ============================================================
# SENTIMENT ANALYSIS WITH LOGISTIC REGRESSION
# DATA LOADING + DATA CLEANING
# ============================================================

# 1. IMPORT LIBRARIES
# ============================================================

import os
import glob
import re
import html
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.feature_extraction.text import ENGLISH_STOP_WORDS

print("Libraries imported successfully!")


# 2. FIND AND LOAD IMDB DATASET
# ============================================================

csv_files = glob.glob(
    "/kaggle/input/**/*.csv",
    recursive=True
)

print("\nCSV files found:")

for file in csv_files:
    print(file)

# Find IMDb Dataset automatically

imdb_files = [
    file for file in csv_files
    if "imdb" in os.path.basename(file).lower()
]

if not imdb_files:
    raise FileNotFoundError(
        "IMDb CSV file not found. Check Kaggle Add Input."
    )

file_path = imdb_files[0]

data = pd.read_csv(file_path)

print("\nDataset loaded successfully!")

print("Dataset path:", file_path)

print("Original Dataset Shape:", data.shape)

# Normalize column names

data.columns = data.columns.str.strip().str.lower()

# Check columns

if not {"review", "sentiment"}.issubset(data.columns):
    raise ValueError(
        "Dataset must contain review and sentiment columns."
    )

display(data.head())


# 3. DATA EXPLORATION
# ============================================================

print("\nDataset Information:")

data.info()

print("\nMissing Values:")

print(data.isnull().sum())

print("\nDuplicate Reviews:")

print(data["review"].duplicated().sum())

print("\nSentiment Distribution:")

print(data["sentiment"].value_counts())


# 4. REMOVE MISSING AND DUPLICATE DATA
# ============================================================

# Remove missing values

data = data.dropna(
    subset=["review", "sentiment"]
).copy()

# Remove duplicate reviews

data = data.drop_duplicates(
    subset=["review"]
).copy()

print("\nMissing and duplicate data removed!")

print("Dataset Shape:", data.shape)


# 5. TEXT CLEANING FUNCTION
# ============================================================

# Keep negation words

stop_words = set(ENGLISH_STOP_WORDS) - {
    "not", "no", "nor", "never"
}

def clean_text(text):

    # Convert to string
    text = str(text)

    # Decode HTML entities
    text = html.unescape(text)

    # Convert to lowercase
    text = text.lower()

    # Preserve common contractions
    contractions = {
        "isn't": "is not",
        "wasn't": "was not",
        "aren't": "are not",
        "don't": "do not",
        "doesn't": "does not",
        "didn't": "did not",
        "can't": "can not",
        "couldn't": "could not",
        "wouldn't": "would not",
        "shouldn't": "should not",
        "won't": "will not"
    }

    for old, new in contractions.items():
        text = text.replace(old, new)

    # Remove HTML tags
    text = re.sub(r"<[^>]+>", " ", text)

    # Remove URLs
    text = re.sub(
        r"http\S+|www\S+",
        " ",
        text
    )

    # Remove punctuation and special characters
    text = re.sub(
        r"[^a-zA-Z\s]",
        " ",
        text
    )

    # Remove extra spaces
    text = re.sub(
        r"\s+",
        " ",
        text
    ).strip()

    # Tokenization
    words = text.split()

    # Remove stopwords
    words = [
        word for word in words
        if word not in stop_words
    ]

    return " ".join(words)


# 6. APPLY TEXT CLEANING
# ============================================================

data["clean_review"] = data["review"].apply(clean_text)

# Remove empty reviews

data = data[
    data["clean_review"].str.strip() != ""
].copy()

print("\nText cleaning completed successfully!")


# 7. ENCODE SENTIMENT LABELS
# ============================================================

data["sentiment"] = (
    data["sentiment"]
    .astype(str)
    .str.strip()
    .str.lower()
)

# Convert labels into numerical values

data["sentiment"] = data["sentiment"].map({
    "negative": 0,
    "positive": 1
})

# Remove invalid labels

data = data.dropna(
    subset=["sentiment"]
).copy()

data["sentiment"] = data["sentiment"].astype(int)

data = data.reset_index(drop=True)


# 8. DISPLAY CLEANING RESULTS
# ============================================================

print("\n========== CLEANING RESULTS ==========")

print("\nFinal Dataset Shape:")

print(data.shape)

print("\nMissing Values After Cleaning:")

print(
    data[["review", "clean_review", "sentiment"]]
    .isnull()
    .sum()
)

print("\nDuplicate Reviews After Cleaning:")

print(data["review"].duplicated().sum())

print("\nFirst 5 Cleaned Reviews:")

display(
    data[["review", "clean_review", "sentiment"]].head()
)


# 9. SENTIMENT DISTRIBUTION
# ============================================================

plt.figure(figsize=(8, 5))

sns.countplot(
    data=data,
    x="sentiment",
    hue="sentiment",
    palette="Set2",
    legend=False
)

plt.title("Sentiment Distribution After Cleaning")

plt.xlabel("Sentiment (0 = Negative, 1 = Positive)")

plt.ylabel("Number of Reviews")

plt.xticks(
    [0, 1],
    ["Negative", "Positive"]
)

plt.show()


# 10. BEFORE AND AFTER CLEANING
# ============================================================

print("\n========== CLEANING EXAMPLE ==========")

print("\nOriginal Review:")

print(data["review"].iloc[0])

print("\nCleaned Review:")

print(data["clean_review"].iloc[0])


# 11. SAVE CLEANED DATASET
# ============================================================

output_path = "/kaggle/working/cleaned_imdb_dataset.csv"

data.to_csv(
    output_path,
    index=False
)

print("\n======================================")

print("DATA CLEANING COMPLETED SUCCESSFULLY!")

print("======================================")

print("\nTotal Reviews:", len(data))

print("Total Columns:", len(data.columns))

print("\nFinal Columns:")

print(data.columns.tolist())

print("\nSaved File:", output_path)




# ============================================================
# SENTIMENT ANALYSIS WITH LOGISTIC REGRESSION
# PART 2: MODEL TRAINING AND EVALUATION
# USING THE EXISTING CLEANED DATA
# ============================================================

# 1. IMPORT LIBRARIES
# ============================================================

import joblib
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.model_selection import train_test_split, GridSearchCV
from sklearn.pipeline import Pipeline
from sklearn.feature_extraction.text import TfidfVectorizer

from sklearn.linear_model import LogisticRegression
from sklearn.dummy import DummyClassifier
from sklearn.naive_bayes import MultinomialNB
from sklearn.svm import LinearSVC

from sklearn.metrics import (
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    confusion_matrix,
    classification_report
)

print("Libraries imported successfully!")


# 2. PREPARE FEATURES AND TARGET
# ============================================================

# Use the existing cleaned DataFrame: data

X = data["clean_review"].astype(str)
y = data["sentiment"].astype(int)

print("\nData prepared successfully!")
print("Total Reviews:", len(X))


# 3. TRAIN / TEST SPLIT
# ============================================================

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42,
    stratify=y
)

print("\nTraining samples:", len(X_train))
print("Testing samples:", len(X_test))


# 4. BASELINE MODEL
# ============================================================

baseline_model = Pipeline([
    ("tfidf", TfidfVectorizer(
        max_features=20000,
        ngram_range=(1, 2),
        min_df=2
    )),
    ("classifier", DummyClassifier(
        strategy="most_frequent"
    ))
])

baseline_model.fit(X_train, y_train)

baseline_pred = baseline_model.predict(X_test)

print("\n========== BASELINE RESULTS ==========")

print(
    "Baseline Accuracy:",
    round(accuracy_score(y_test, baseline_pred), 4)
)


# 5. LOGISTIC REGRESSION TRAINING
# ============================================================

logistic_model = Pipeline([
    ("tfidf", TfidfVectorizer(
        max_features=20000,
        ngram_range=(1, 2),
        min_df=2,
        max_df=0.95,
        sublinear_tf=True
    )),
    ("classifier", LogisticRegression(
        C=1.0,
        max_iter=1000,
        random_state=42
    ))
])

logistic_model.fit(X_train, y_train)

print("\nLogistic Regression trained successfully!")

y_pred = logistic_model.predict(X_test)


# 6. MODEL EVALUATION
# ============================================================

print("\n========== LOGISTIC REGRESSION RESULTS ==========")

print("Accuracy:",
      round(accuracy_score(y_test, y_pred), 4))

print("Precision:",
      round(precision_score(y_test, y_pred), 4))

print("Recall:",
      round(recall_score(y_test, y_pred), 4))

print("F1-Score:",
      round(f1_score(y_test, y_pred), 4))

print("\nClassification Report:")

print(classification_report(
    y_test,
    y_pred,
    target_names=["Negative", "Positive"]
))


# 7. CONFUSION MATRIX
# ============================================================

cm = confusion_matrix(y_test, y_pred)

plt.figure(figsize=(7, 5))

sns.heatmap(
    cm,
    annot=True,
    fmt="d",
    cmap="Blues",
    xticklabels=["Negative", "Positive"],
    yticklabels=["Negative", "Positive"]
)

plt.title("Confusion Matrix - Logistic Regression")
plt.xlabel("Predicted Sentiment")
plt.ylabel("Actual Sentiment")
plt.show()


# 8. HYPERPARAMETER TUNING - GRID SEARCH
# ============================================================

grid_pipeline = Pipeline([
    ("tfidf", TfidfVectorizer(
        max_features=20000,
        ngram_range=(1, 2),
        min_df=2,
        max_df=0.95,
        sublinear_tf=True
    )),
    ("classifier", LogisticRegression(
        max_iter=1500,
        random_state=42
    ))
])

param_grid = {
    "classifier__C": [0.01, 0.1, 1, 10, 100]
}

grid_search = GridSearchCV(
    estimator=grid_pipeline,
    param_grid=param_grid,
    cv=3,
    scoring="f1",
    n_jobs=-1,
    verbose=1
)

print("\nStarting GridSearchCV...")

grid_search.fit(X_train, y_train)

print("\nBest Parameters:")
print(grid_search.best_params_)

print("\nBest Cross-Validation F1-Score:")
print(round(grid_search.best_score_, 4))


# 9. OPTIMIZED MODEL EVALUATION
# ============================================================

best_model = grid_search.best_estimator_

best_pred = best_model.predict(X_test)

print("\n========== OPTIMIZED MODEL RESULTS ==========")

print("Accuracy:",
      round(accuracy_score(y_test, best_pred), 4))

print("Precision:",
      round(precision_score(y_test, best_pred), 4))

print("Recall:",
      round(recall_score(y_test, best_pred), 4))

print("F1-Score:",
      round(f1_score(y_test, best_pred), 4))

print("\nClassification Report:")

print(classification_report(
    y_test,
    best_pred,
    target_names=["Negative", "Positive"]
))


# 10. OPTIMIZED CONFUSION MATRIX
# ============================================================

cm_best = confusion_matrix(y_test, best_pred)

plt.figure(figsize=(7, 5))

sns.heatmap(
    cm_best,
    annot=True,
    fmt="d",
    cmap="Greens",
    xticklabels=["Negative", "Positive"],
    yticklabels=["Negative", "Positive"]
)

plt.title("Optimized Logistic Regression Confusion Matrix")
plt.xlabel("Predicted Sentiment")
plt.ylabel("Actual Sentiment")
plt.show()


# 11. COMPARE DIFFERENT MODELS
# ============================================================

models = {
    "Logistic Regression": best_model,

    "Naive Bayes": Pipeline([
        ("tfidf", TfidfVectorizer(
            max_features=20000,
            ngram_range=(1, 2),
            min_df=2
        )),
        ("classifier", MultinomialNB())
    ]),

    "SVM": Pipeline([
        ("tfidf", TfidfVectorizer(
            max_features=20000,
            ngram_range=(1, 2),
            min_df=2
        )),
        ("classifier", LinearSVC())
    ])
}

results = []

for name, model in models.items():

    print("\nTraining:", name)

    if name != "Logistic Regression":
        model.fit(X_train, y_train)

    predictions = model.predict(X_test)

    results.append({
        "Model": name,
        "Accuracy": accuracy_score(y_test, predictions),
        "Precision": precision_score(y_test, predictions),
        "Recall": recall_score(y_test, predictions),
        "F1-Score": f1_score(y_test, predictions)
    })

results_df = pd.DataFrame(results)

print("\n========== MODEL COMPARISON ==========")

display(
    results_df.sort_values(
        by="F1-Score",
        ascending=False
    )
)


# 12. VISUALIZE MODEL COMPARISON
# ============================================================

results_melted = results_df.melt(
    id_vars="Model",
    var_name="Metric",
    value_name="Score"
)

plt.figure(figsize=(10, 6))

sns.barplot(
    data=results_melted,
    x="Model",
    y="Score",
    hue="Metric"
)

plt.title("Performance Comparison of Machine Learning Models")
plt.ylim(0, 1)
plt.xticks(rotation=15)
plt.tight_layout()
plt.show()


# 13. SAVE BEST MODEL AND RESULTS
# ============================================================

joblib.dump(
    best_model,
    "/kaggle/working/sentiment_model.pkl"
)

results_df.to_csv(
    "/kaggle/working/model_comparison.csv",
    index=False
)

print("\nModel saved successfully!")
print("sentiment_model.pkl")
print("model_comparison.csv")


# 14. TEST WITH NEW REVIEWS
# ============================================================

def predict_sentiment(review):

    prediction = best_model.predict([review])[0]

    probabilities = best_model.predict_proba([review])[0]

    confidence = max(probabilities) * 100

    sentiment = (
        "Positive"
        if prediction == 1
        else "Negative"
    )

    print("\nReview:", review)
    print("Prediction:", sentiment)
    print("Confidence:", round(confidence, 2), "%")


print("\n========== NEW REVIEW TESTS ==========")

predict_sentiment(
    "This movie was amazing and wonderful. I loved it!"
)

predict_sentiment(
    "This movie was boring and terrible. I hated it!"
)

print("\n======================================")
print("PROJECT TRAINING COMPLETED!")
print("======================================")

